<UserControl x:Class="RemotePc.Shell.Pages.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True" Drop="OnDrop" DragEnter="OnDragOver"
             DragOver="OnDragOver" DragLeave="OnDragLeave">
    <StackPanel>

        <ui:CardControl Margin="0,0,0,6">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="FolderOpen24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Shared folder" />
                    <TextBlock x:Name="FolderPath" Text="—" FontSize="12" Opacity="0.6"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Click="OnOpenFolder" AutomationProperties.Name="Open the folder">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Open24" FontSize="14" />
                        <TextBlock Text="Open" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="8,0,0,0" Click="OnRefresh" AutomationProperties.Name="Refresh the list">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                </ui:Button>
            </StackPanel>
        </ui:CardControl>

        <!-- The whole page accepts a drop; this only says so. Copying into the
             folder is the same gesture as sending to the phone, so there is no
             separate "send" action to learn. -->
        <Border x:Name="DropZone" Margin="0,8,0,10" Height="86" CornerRadius="8"
                BorderThickness="1" BorderBrush="#33FFFFFF" Background="#0AFFFFFF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Opacity="0.55"
                               HorizontalAlignment="Center" />
                <TextBlock x:Name="DropText" Text="Drop files here to send them to the phone"
                           FontSize="12.5" Opacity="0.6" Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="CountText" Text="" FontSize="12" Margin="4,0,0,8"
                   Foreground="{DynamicResource MutedBrush}" />

        <ItemsControl x:Name="FileList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,6">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.6"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button Appearance="Transparent" Padding="8,4"
                                   Click="OnDeleteFile" Tag="{Binding Name}"
                                   ToolTip="Delete" AutomationProperties.Name="Delete this file">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                        </ui:Button>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" Margin="4,6,0,0" FontSize="12.5"
                   Foreground="{DynamicResource MutedBrush}"
                   Text="Nothing here yet. Drop a file above, or send one from the phone."
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
