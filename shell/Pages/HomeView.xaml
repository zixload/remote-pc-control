<UserControl x:Class="RemotePc.Shell.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- Same metrics as the Umbra stats tiles: 18px icon at 0.6 opacity,
             12px label at 0.6, 18px semi-bold value. -->
        <Style x:Key="TileIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,2,10,0" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- 15 rather than Umbra's 18: its stats page shows durations, three
             or four characters that carry the whole tile. Here the values are
             sentences of their own ("ddagrab (GPU)"), and at 18 they dominated
             the card. -->
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- Les deux codes cote a cote : ce sont deux chemins vers la meme
             chose, les mettre l un sous l autre suggerait une hierarchie qui
             n existe pas. Le libelle passe sous le code plutot qu a cote,
             faute de largeur une fois la rangee coupee en deux. -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RemoteColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Etirees toutes les deux sur la hauteur de la rangee : sans cela
                 ui:Card se dimensionne sur son contenu, et celle de droite,
                 qui porte une ligne de moins, se retrouvait plus courte et
                 centree verticalement. -->
            <ui:Card Grid.Column="0" Margin="0,0,4,0"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <Border Width="156" Height="156" CornerRadius="8"
                            HorizontalAlignment="Center"
                            Background="White" Padding="8">
                        <Grid>
                            <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock x:Name="QrPlaceholder" Text="Server stopped"
                                       Foreground="#6A6A6A" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="15" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="On the Wi-Fi" Margin="8,0,0,0"
                                   Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="UrlText" Text="—" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ui:Button x:Name="CopyUrl" Appearance="Transparent" Margin="6,0,0,0"
                                   Padding="5,2" Click="OnCopyUrl" ToolTip="Copy the address"
                                   AutomationProperties.Name="Copy the address"
                                   IsEnabled="False">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="13" />
                        </ui:Button>
                    </StackPanel>

                    <TextBlock Text="PIN" Style="{StaticResource TileLabel}" Margin="0,12,0,0" />
                    <TextBlock x:Name="PinText" Text="—" FontSize="16" FontWeight="SemiBold"
                               Margin="0,2,0,0" />

                    <TextBlock x:Name="PinWarning" Margin="0,8,0,0" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource WarnBrush}" />
                </StackPanel>
            </ui:Card>

            <!-- Masquee tant qu aucun reseau prive n est detecte : une carte
                 vide promettrait quelque chose qui n existe pas. -->
            <ui:Card Grid.Column="1" x:Name="RemoteCard" Margin="4,0,0,0"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                     Visibility="Collapsed">
                <StackPanel>
                    <Border Width="156" Height="156" CornerRadius="8"
                            HorizontalAlignment="Center"
                            Background="White" Padding="8">
                        <Image x:Name="RemoteQr" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:SymbolIcon Symbol="Earth24" FontSize="15" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="From anywhere" Margin="8,0,0,0"
                                   Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="RemoteText" Text="—" FontSize="16" FontWeight="SemiBold"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                    <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Over the encrypted private network. Nothing is exposed publicly." />
                </StackPanel>
            </ui:Card>

        </Grid>

        <!-- Six facts in one card rather than six stacked rows: they are read
             at a glance, not one after the other. -->
        <ui:Card>
            <UniformGrid Columns="3" Rows="2" Margin="14,10">

                <Grid Margin="8,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" Style="{StaticResource TileIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Displays" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="ScreensText" Text="—" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="8,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="ShareScreenStart24" Style="{StaticResource TileIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Streaming" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="StreamingText" Text="—" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="8,8,12,8" x:Name="WidthTile">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowAutofitWidth24" Style="{StaticResource TileIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Width" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="WidthText" Text="—" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="8,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Timer24" Style="{StaticResource TileIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Frame rate" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="FpsText" Text="—" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="8,8,12,8" x:Name="CinemaTile">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="MoviesAndTv24" Style="{StaticResource TileIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Cinema mode" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="CinemaText" Text="—" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="8,8,12,8" x:Name="SoundTile">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Speaker224" Style="{StaticResource TileIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Sound" Style="{StaticResource TileLabel}" />
                        <TextBlock x:Name="AudioText" Text="—" Style="{StaticResource TileValue}" />
                    </StackPanel>
                </Grid>
            </UniformGrid>
        </ui:Card>

        <!-- Une carte comme les autres, pleine largeur, plutot qu un bouton
             pose au milieu du vide : un carre clair flottant ne ressemblait a
             rien d autre sur la page. L icone seule, sans libelle - marche et
             arret se lisent plus vite que n importe quel mot - et l etat est
             dit par la couleur du texte a cote. -->
        <ui:Card Margin="0,8,0,0" Padding="0">
            <ui:Button Appearance="Transparent" Click="OnToggleServer"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Padding="0,14" BorderThickness="0"
                       AutomationProperties.Name="Start or stop the server">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="ToggleIcon" Symbol="Play24" Filled="True"
                                   FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="StatusText" Text="Stopped" Margin="10,0,0,0"
                               FontSize="13.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </ui:Button>
        </ui:Card>

    </StackPanel>
</UserControl>
