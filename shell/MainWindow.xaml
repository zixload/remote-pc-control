<ui:FluentWindow x:Class="RemotePc.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:RemotePc.Shell"
                 xmlns:pages="clr-namespace:RemotePc.Shell.Pages"
                 Title="Remote PC" Height="660" Width="900"
                 MinHeight="520" MinWidth="760"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Default">

    <ui:FluentWindow.Resources>
        <!-- A hand-rolled navigation rail rather than ui:NavigationView: that
             control swallows the initial MouseDown in an internal Grid, which
             makes its SelectionChanged unreliable and calls for workarounds.
             At this size, a restyled RadioButton is shorter and behaves. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="6,2,6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Height="38" />
                            <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Opacity="0" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <ui:SymbolIcon Symbol="{TemplateBinding Tag}" FontSize="17"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="13.5"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Marker" Property="Opacity" Value="1" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One colour per level: in a stream of lines, that is what makes a
             refused PIN or an exception stand out. -->
        <Style x:Key="LogRow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Peinte de la meme teinte que le panneau lateral, et rabaissee :
             la bande du haut restait en Mica, donc d une autre couleur que
             tout le reste. Les deux forment maintenant un seul L continu. -->
        <Border Grid.Row="0" Background="{DynamicResource ShellPaneBrush}">
            <ui:TitleBar Title="Remote PC" ShowMaximize="True" Height="32" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side pane, in the same tint as Umbra's. -->
            <Border Grid.Column="0" Background="{DynamicResource ShellPaneBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,4,0,0">
                        <!-- Tag carries the enum value, not its name:
                             TemplateBinding does not convert a string to
                             SymbolRegular, and the icon would stay blank. -->
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}"
                                     Tag="{x:Static ui:SymbolRegular.Home24}"
                                     Content="Home" GroupName="nav" IsChecked="True"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavFiles" Style="{StaticResource NavItem}"
                                     Tag="{x:Static ui:SymbolRegular.FolderArrowUp24}"
                                     Content="Files" GroupName="nav"
                                     Checked="OnNavChecked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}"
                                     Tag="{x:Static ui:SymbolRegular.Settings24}"
                                     Content="Settings" GroupName="nav"
                                     Checked="OnNavChecked" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="18,0,18,16">
                        <TextBlock x:Name="PaneStatus" Text="Stopped" FontSize="11.5"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ShellContentBrush}"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,12">
                        <Grid>
                            <pages:HomeView x:Name="HomePage" />
                            <pages:FilesView x:Name="FilesPage" Visibility="Collapsed" />
                            <pages:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <!-- The log is collapsed by default, down to its own title
                         bar. That is the compromise asked for: present, but
                         not in the way. -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,0"
                            BorderBrush="#1FFFFFFF" Padding="18,8,18,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0" x:Name="LogToggle" Appearance="Transparent"
                                           Padding="4,2" Click="OnToggleLog"
                                           AutomationProperties.Name="Expand or collapse the log">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="LogChevron" Symbol="ChevronUp24" FontSize="14" />
                                        <TextBlock Text="Log" Margin="8,0,0,0" FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="LogBadge" Margin="8,0,0,0" CornerRadius="8"
                                                Background="{DynamicResource DangerBrush}"
                                                Padding="6,0" Visibility="Collapsed"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="LogBadgeText" Text="0" FontSize="10.5"
                                                       Foreground="#1A1A1A" />
                                        </Border>
                                    </StackPanel>
                                </ui:Button>

                                <CheckBox Grid.Column="2" x:Name="VerboseCheck" Content="Show all"
                                          FontSize="12" VerticalAlignment="Center"
                                          Checked="OnVerboseChanged" Unchecked="OnVerboseChanged"
                                          ToolTip="Adds the HTTP requests: one line per focus poll, about one a second." />

                                <ui:Button Grid.Column="3" Appearance="Transparent" Margin="10,0,0,0"
                                           Padding="6,2" Click="OnClearLog" ToolTip="Clear"
                                           AutomationProperties.Name="Clear the log">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                                </ui:Button>
                            </Grid>

                            <Border Grid.Row="1" x:Name="LogBody" Height="168" Margin="0,8,0,0"
                                    Background="#0C0C0C" CornerRadius="6" Padding="10,6"
                                    Visibility="Collapsed">
                                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource LogRow}"
                                                           Foreground="{Binding Level,
                                                               Converter={x:Static local:LevelBrushConverter.Instance}}">
                                                    <Run Text="{Binding Time, Mode=OneWay}"
                                                         Foreground="{DynamicResource MutedBrush}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
